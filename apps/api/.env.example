# PostgreSQL (docker compose up -d, at the repository root, starts it). The e2e
# tests use the budget_test database of the same server (never this one)
DATABASE_URL="postgresql://budget:budget@localhost:5432/budget"

# Secret that signs the access tokens. Required; use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me"

# Optional (defaults shown)
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7
# COOKIE_SECURE=            # defaults to true when NODE_ENV=production
# TRUST_PROXY=              # e.g. 1 behind one reverse proxy (client IP for rate limiting)
# PORT=3000

# Sign-in with GitHub/Google (optional; each provider needs both values).
# Callback URLs to register at the providers (dev, through the Vite proxy):
#   http://localhost:5173/api/auth/oauth/github/callback
#   http://localhost:5173/api/auth/oauth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# WEB_URL=http://localhost:5173                # where the OAuth callback lands
# OAUTH_CALLBACK_BASE_URL=                     # defaults to $WEB_URL/api (the API as the browser sees it)

# E-mail (account activation links, group invitations). Without SMTP_HOST the
# messages are only written to the API log (links included); required when
# NODE_ENV=production. Local test inbox with Mailpit:
#   docker run --rm -p 1025:1025 -p 8025:8025 axllent/mailpit   (UI: http://localhost:8025)
#   SMTP_HOST=localhost SMTP_PORT=1025
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false                            # true for TLS from the start (port 465)
# SMTP_USER=                                   # SMTP_USER and SMTP_PASS go together
# SMTP_PASS=
# MAIL_FROM="Budget <no-reply@budget.local>"
# ACTIVATION_TOKEN_TTL_HOURS=72
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60          # "Esqueci minha senha" link lifetime
# WEB_URL also builds the links in the e-mails (/ativar-conta, /redefinir-senha, /grupos)
