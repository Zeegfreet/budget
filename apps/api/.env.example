# SQLite file. Tests use file:./test.db (never dev.db)
DATABASE_URL="file:./dev.db"

# Secret that signs the access tokens. Required; use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me"

# Optional (defaults shown)
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7
# COOKIE_SECURE=            # defaults to true when NODE_ENV=production
# TRUST_PROXY=              # e.g. 1 behind one reverse proxy (client IP for rate limiting)
# PORT=3000
