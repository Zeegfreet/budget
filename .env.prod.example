# Production settings for docker-compose.prod.yml (copy to .env.prod, never commit it).

# Traefik / compose
DOMAIN=budget.exemplo.com
ACME_EMAIL=voce@exemplo.com
# BUDGET_TAG=1.0.0                         # image tag (default latest)

# PostgreSQL (the db service). Use a long random password; it must match DATABASE_URL
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://budget:change-me@db:5432/budget

# Signs the access tokens; long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me

# E-mail (required: NODE_ENV=production in the image)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Budget <no-reply@budget.exemplo.com>"

# Sign-in with GitHub/Google (optional, in pairs). Callbacks:
#   https://<DOMAIN>/api/auth/oauth/github/callback
#   https://<DOMAIN>/api/auth/oauth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Already set by the image/compose (override only if needed):
# NODE_ENV=production API_PREFIX=api WEB_DIST_DIR=/app/web PORT=3000
# TRUST_PROXY=1 WEB_URL=https://<DOMAIN>
# SKIP_MIGRATIONS=true                     # skip prisma migrate deploy on start
